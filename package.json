{
  "name": "plotter",
  "version": "2.0.0",
  "description": "Mac OS app to plot numbers from a CSV-like file",
  "license": "MIT",
  "author": "Lawrence Kesteloot",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && electron dist/main.js",
    "app": "npm run build && electron-builder --mac --dir",
    "icon": "node build.mjs && electron icon/make-icon.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.headcode.plotter",
    "productName": "Plotter",
    "directories": {
      "output": "build",
      "buildResources": "icon"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "icon/Plotter.icns"
    }
  }
}
